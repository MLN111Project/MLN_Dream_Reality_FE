# Gemini API — chỉ dùng trên server (npm run server), không commit .env thật
GEMINI_API_KEY=AIzaSyCGupfzmi0NA7Cmm_5QDBkdzTkfwMJvksA
# Tuỳ chọn: gemini-2.0-flash | gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash
# === Vercel (Frontend) — Settings → Environment Variables ===
# URL server game đã deploy (Render/Railway), KHÔNG có dấu / ở cuối
# Ví dụ: https://dream-reality-game-server.onrender.com
VITE_SOCKET_URL=https://mln-dream-reality-fe.onrender.com

# === Game server (Render/Railway) — Environment Variables ===
# Domain Vercel của bạn, có thể nhiều domain cách nhau bởi dấu phẩy
# CLIENT_ORIGINS=https://your-app.vercel.app,https://your-app-xxx.vercel.app
CLIENT_ORIGINS=https://mln-dream-reality-fe.vercel.app/
PORT=3001
